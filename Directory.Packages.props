<Project>
  <!-- Central package management: every package version is declared once, here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Umbraco versions per major (ADR 0001; UmbracoMajor comes from Directory.Build.props).
    UmbracoPackageRange: what the package compiles against (the floor) and declares to NuGet.
    UmbracoDevVersion: the concrete version sample sites and tests run, pinned with VersionOverride
    where a project references a package that also carries the range.
  -->
  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <UmbracoPackageRange>[17.0.0, 18.0.0)</UmbracoPackageRange>
    <UmbracoDevVersion>17.7.1</UmbracoDevVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <UmbracoPackageRange>[18.0.0, 19.0.0)</UmbracoPackageRange>
    <UmbracoDevVersion>18.2.0</UmbracoDevVersion>
  </PropertyGroup>

  <ItemGroup Label="Umbraco">
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoDevVersion)" />
    <PackageVersion
      Include="Umbraco.Cms.DevelopmentMode.Backoffice"
      Version="$(UmbracoDevVersion)"
    />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

  <ItemGroup Label="Security patches">
    <!--
      Patched versions of packages that Umbraco brings in transitively, referenced by the tests and sample
      sites only: 10.0.13 fixes the advisories published on 2026-10-13 (CVE-2026-84008 and others), which
      Umbraco 17.7 and 18.2 still resolve. The package does not reference them, because a consuming site
      resolves its own. Remove these and their references once UmbracoDevVersion depends on 10.0.13 or later.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!--
      MessagePack 3.1.12 fixes GHSA-qhrr-8q5h-9q3h (published 2026-10-15), which Umbraco 17.7 and 18.2 still
      resolve at 3.1.8. Referenced by the tests and sample sites only. Remove it and its references once
      UmbracoDevVersion resolves 3.1.9 or later.
    -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>
