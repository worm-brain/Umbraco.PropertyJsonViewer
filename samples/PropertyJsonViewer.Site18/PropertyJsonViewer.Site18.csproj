<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Umbraco 18 sample site for developing and testing the package. Not packed. -->
  <PropertyGroup>
    <!-- The Umbraco major this site runs on; a build for another major skips it (Directory.Build.targets). -->
    <SampleUmbracoMajor>18</SampleUmbracoMajor>
    <!-- Disable compression: the backoffice files are precompressed and dotnet must not handle them. -->
    <CompressionEnabled>false</CompressionEnabled>
    <!-- Sample code is not shipped, so it does not need XML docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SixLabors.ImageSharp 3.1.12 comes in through Umbraco.Cms and is flagged by these advisories
      (published 2026-10-07; fixed only in 4.1.2, which Umbraco 17/18 do not build against).
      GHSA-v76p-62qx-wwq2 is fixed in 3.2.0, but 3.2 adds a Six Labors licence check that fails the build
      without a key, so it is suppressed too rather than pinned. The sample site is not shipped, and the
      package itself does not reference ImageSharp. Remove these once Umbraco ships a patched ImageSharp.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
    <!-- A patched version of an Umbraco transitive dependency (Directory.Packages.props). Remove once Umbraco ships it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption
      Include="System.Globalization.AppLocalIcu"
      Value="72.1.0.3"
      Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- Seeded test content is shared by both sample sites. The stand-in third-party editor is copied into each site's wwwroot/App_Plugins/SampleThirdParty: Umbraco's package manifest reader cannot open linked files. -->
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbraco.Community.PropertyJsonViewer\Umbraco.Community.PropertyJsonViewer.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>
</Project>
